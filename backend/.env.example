# Server
PORT=5000
NODE_ENV=development
NODE_VERSION=22

# Database - use DATABASE_URL for Neon/Render/Supabase PostgreSQL.
# Example Neon URL:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/truck_business?sslmode=require
DATABASE_URL=

# Local PostgreSQL fallback. Used only when DATABASE_URL is empty.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=truck_business
DB_USER=postgres
DB_PASSWORD=password
DB_SSL=false

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRY=7d

# App / CORS
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
# Optional comma-separated extra frontend URLs:
# CORS_ORIGINS=https://your-project.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=
# Keep true for Vercel preview deployment URLs like https://project-git-branch-user.vercel.app
ALLOW_VERCEL_PREVIEWS=true
ALLOW_NETLIFY_PREVIEWS=false

# Development admin bootstrap. Set AUTO_CREATE_ADMIN=false after first production login.
AUTO_CREATE_ADMIN=true
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=password123

# Automatically apply SQL migrations when backend starts in development.
RUN_MIGRATIONS_ON_START=true
